    "connection.howItWorks": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это работает"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        }
      }
    },
    "connection.howItWorksBody": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После нажатия «Получить токен» приложение читает локальный токен сессии из базы Cursor, сохраняет его локально и опрашивает сервер Cursor для отображения расхода квоты. Токен никуда, кроме серверов Cursor, не отправляется."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you tap “Get token”, the app reads the local session token from Cursor’s database, stores it locally, and polls Cursor’s servers to show quota usage. The token is never sent anywhere except Cursor’s servers."
          }
        }
      }
    },
    "connection.checking": {
      "localizations": {
